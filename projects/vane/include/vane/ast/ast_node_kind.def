    /* VISIT */
)

/*..............................END OF DEFINES................................*/

#undef AST_NODE
#undef AST_NODE_VISIT_CHILD_FN
#undef AST_NODE_MISC
#undef AST_NODE_TYPEREF
#undef AST_NODE_STMT
#undef AST_NODE_EXPR