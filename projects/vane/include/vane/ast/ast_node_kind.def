/*..............................START OF DEFINES..............................*/

#ifndef AST_NODE
#define AST_NODE(KIND, NAME, STRUCT, DESTROY, VISIT)
#endif

#ifndef AST_NODE_GROUP
#define AST_NODE_GROUP(KIND, NAME) AST_NODE(GROUP_##KIND, NAME, /* STRUCT */, /* DESTROY */, /* VISIT */)
#endif

#ifndef AST_NODE_VISIT_CHILD_FN
#define AST_NODE_VISIT_CHILD_FN(...)
#endif

/*..............................GROUP.........................................*/

AST_NODE_GROUP(MISC, "misc")
AST_NODE_GROUP(PACKAGE_ENTITY, "package:entity")
AST_NODE_GROUP(TYPEREF, "typeref")
AST_NODE_GROUP(STMT, "stmt")
AST_NODE_GROUP(EXPR, "expr")
AST_NODE_GROUP(EXPR_NUD, "expr:nud")
AST_NODE_GROUP(EXPR_LED, "expr:led")

/*..............................MISC..........................................*/

#ifndef AST_NODE_MISC
#define AST_NODE_MISC(KIND, NAME, STRUCT, DESTROY, VISIT) AST_NODE(KIND, NAME, STRUCT, DESTROY, VISIT)
#endif

AST_NODE_MISC(UNKNOWN, "unknown", /* STRUCT */, /* DESTROY */, /* VISIT */)

AST_NODE_MISC(ERROR,   "error", struct {
    ASTNodeKind failed;
    ASTNode* prev;
} error;,
    ast_node_destroy(node->as.error.prev);,

    AST_NODE_VISIT_CHILD_FN(node->as.error.prev)
)

AST_NODE_MISC(IDENTIFIER, "identifier", struct {
    String value;
} id;,
    string_destroy(&node->as.id.value);,
    /* VISIT */
)

AST_NODE_MISC(SOURCE_FILE, "source_file", struct {
    Vector entities;
} source_file;,
    vector_destroy(&node->as.source_file.entities);,

    for (u32 i = 0; i < node->as.source_file.entities.size; ++i) {
        AST_NODE_VISIT_CHILD_FN(vector_at(node->as.source_file.entities, i));
    }
)

AST_NODE_MISC(IMPORT_DECL, "import:decl", struct {
    ASTNode* path;
    ASTNode* alias;
} import_decl;,
    ast_node_destroy(node->as.import_decl.path);
    ast_node_destroy(node->as.import_decl.alias);,

    AST_NODE_VISIT_CHILD_FN(node->as.import_decl.path);
    AST_NODE_VISIT_CHILD_FN(node->as.import_decl.alias);
)

AST_NODE_MISC(FUN_PARAM, "fun:param", struct {
    ASTNode* id;
    ASTNode* typeref;
} fun_param;,
    ast_node_destroy(node->as.fun_param.id);
    ast_node_destroy(node->as.fun_param.typeref);,

    AST_NODE_VISIT_CHILD_FN(node->as.fun_param.id);
    AST_NODE_VISIT_CHILD_FN(node->as.fun_param.typeref);
)

AST_NODE_MISC(FUN_SIGN, "fun:sign", struct {
    ASTNode* id;
    Vector params;
    ASTNode* typeref;
} fun_sign;,
    ast_node_destroy(node->as.fun_sign.id);
    vector_destroy(&node->as.fun_sign.params);
    ast_node_destroy(node->as.fun_sign.typeref);,

    AST_NODE_VISIT_CHILD_FN(node->as.fun_sign.id);
    AST_NODE_VISIT_CHILD_FN(node->as.fun_sign.typeref);
    for (u32 i = 0; i < node->as.fun_sign.params.size; ++i) {
        AST_NODE_VISIT_CHILD_FN(vector_at(node->as.fun_sign.params, i));
    }
)

AST_NODE_MISC(FUN_DECL, "fun:decl", struct {
    ASTNode* sign;
    Vector block;
} fun_decl;,
    ast_node_destroy(node->as.fun_decl.sign);
    vector_destroy(&node->as.fun_decl.block);,

    AST_NODE_VISIT_CHILD_FN(node->as.fun_decl.sign);
    for (u32 i = 0; i < node->as.fun_decl.block.size; ++i) {
        AST_NODE_VISIT_CHILD_FN(vector_at(node->as.fun_decl.block, i));
    }
)

