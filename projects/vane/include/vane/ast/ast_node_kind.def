AST_NODE_TYPEREF(FUN_PARAM, "fun:param", struct {
    ASTNode* id;
    ASTNode* typeref;
} typeref_fun_param;,
    ast_node_destroy(node->as.typeref_fun_param.id);
    ast_node_destroy(node->as.typeref_fun_param.typeref);,

