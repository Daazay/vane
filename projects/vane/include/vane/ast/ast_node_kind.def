/*..............................EXPR..........................................*/

#ifndef AST_NODE_EXPR
#define AST_NODE_EXPR(KIND, NAME, STRUCT, DESTROY, VISIT) AST_NODE(EXPR_##KIND, "expr:"NAME, STRUCT, DESTROY, VISIT)
#endif


AST_NODE_EXPR(BINARY, "binary", struct {
    TokenKind op;
    ASTNode* lhs;
    ASTNode* rhs;
} expr_binary;,
    ast_node_destroy(node->as.expr_binary.lhs);
    ast_node_destroy(node->as.expr_binary.rhs);,

    AST_NODE_VISIT_CHILD_FN(node->as.expr_binary.lhs);
    AST_NODE_VISIT_CHILD_FN(node->as.expr_binary.rhs);
)

