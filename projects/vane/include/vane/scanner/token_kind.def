/*..............................START OF DEFINES..............................*/

#ifndef TOKEN
#define TOKEN(KIND, NAME, VALUE)
#endif

/*..............................MISC..........................................*/

#ifndef TOKEN_MISC
#define TOKEN_MISC(KIND, NAME) TOKEN(KIND, NAME, NAME)
#endif

TOKEN_MISC(UNKNOWN,    "unknown")
TOKEN_MISC(INVALID,    "invalid")
TOKEN_MISC(IDENTIFIER, "identifier")
TOKEN_MISC(EOF_,       "eof")

/*..............................PUNC..........................................*/

#ifndef TOKEN_PUNC
#define TOKEN_PUNC(KIND, NAME, VALUE) TOKEN(KIND, NAME, VALUE)
#endif

TOKEN_PUNC(L_CURLY,       "r_curly",       "{")
TOKEN_PUNC(R_CURLY,       "r_curly",       "}")

TOKEN_PUNC(MINUS_GREATER, "minus_greater", "}")

TOKEN_PUNC(R_BRACE,       "r_brace",       ")")
TOKEN_PUNC(R_BRACKET,     "r_bracket",     "]")
TOKEN_PUNC(COMMA,         "comma",         ",")
TOKEN_PUNC(COLON,         "colon",         ":")
TOKEN_PUNC(SEMICOLON,     "semicolon",     ";")

/*..............................OP............................................*/

#ifndef TOKEN_OP
#define TOKEN_OP(KIND, NAME, VALUE, PREC) TOKEN_PUNC(KIND, NAME, VALUE)
#endif

TOKEN_OP(L_BRACE,   "l_brace",   "(", CALL)
TOKEN_OP(L_BRACKET, "l_bracket", "[", INDEX)
TOKEN_OP(DOT,       "dot",       ".", MEMBER)

/*..............................BINOP.........................................*/

#ifndef TOKEN_BINOP
#define TOKEN_BINOP(KIND, NAME, VALUE, PREC) TOKEN_OP(KIND, NAME, VALUE, PREC)
#endif

TOKEN_BINOP(PLUS,                  "plus",                  "+",   ADDITIVE)
TOKEN_BINOP(PLUS_EQUAL,            "plus_equal",            "+=",  ASSIGNMENT)
TOKEN_BINOP(MINUS,                 "minus",                 "-",   ADDITIVE)
TOKEN_BINOP(MINUS_EQUAL,           "minus_equal",           "-=",  ASSIGNMENT)
TOKEN_BINOP(STAR,                  "star",                  "*",   MULTIPLICATIVE)
TOKEN_BINOP(STAR_EQUAL,            "star_equal",            "*=",  ASSIGNMENT)
TOKEN_BINOP(SLASH,                 "slash",                 "/",   MULTIPLICATIVE)
TOKEN_BINOP(SLASH_EQUAL,           "slash_equal",           "/=",  ASSIGNMENT)
TOKEN_BINOP(PERCENT,               "percent",               "%",   MULTIPLICATIVE)
TOKEN_BINOP(PERCENT_EQUAL,         "percent_equal",         "%=",  ASSIGNMENT)
TOKEN_BINOP(CARET,                 "caret",                 "^",   BIN_XOR)
TOKEN_BINOP(AMP,                   "amp",                   "&",   BIN_AND)
TOKEN_BINOP(AMP_AMP,               "amp_amp",               "&&",  LOGICAL_AND)
TOKEN_BINOP(AMP_EQUAL,             "amp_equal",             "&=",  ASSIGNMENT)
TOKEN_BINOP(PIPE,                  "pipe",                  "|",   BIN_OR)
TOKEN_BINOP(PIPE_PIPE,             "pipe_pipe",             "||",  LOGICAL_OR)
TOKEN_BINOP(PIPE_EQUAL,            "pipe_equal",            "|=",  ASSIGNMENT)
TOKEN_BINOP(EQUAL,                 "equal",                 "=",   ASSIGNMENT)
TOKEN_BINOP(EQUAL_EQUAL,           "equal_equal",           "==",  EQUALITY)
TOKEN_BINOP(EXCLAIM_EQUAL,         "exclaim_equal",         "!=",  EQUALITY)
TOKEN_BINOP(GREATER,               "greater",               ">",   RELATIONAL)
TOKEN_BINOP(GREATER_EQUAL,         "greater_equal",         ">=",  RELATIONAL)
TOKEN_BINOP(GREATER_GREATER,       "greater_greater",       ">>",  SHIFT)
TOKEN_BINOP(GREATER_GREATER_EQUAL, "greater_greater_equal", ">>=", ASSIGNMENT)
TOKEN_BINOP(LESS,                  "less",                  "<",   RELATIONAL)
TOKEN_BINOP(LESS_EQUAL,            "less_equal",            "<=",  RELATIONAL)
TOKEN_BINOP(LESS_LESS,             "less_less",             "<<",  SHIFT)
TOKEN_BINOP(LESS_LESS_EQUAL,       "less_less_equal",       "<<=", ASSIGNMENT)

/*..............................UNOP..........................................*/

#ifndef TOKEN_UNOP
#define TOKEN_UNOP(KIND, NAME, VALUE, PREC) TOKEN_OP(KIND, NAME, VALUE, PREC)
#endif

TOKEN_UNOP(PLUS_PLUS,   "plus_plus",   "++", UNARY)
TOKEN_UNOP(MINUS_MINUS, "minus_minus", "--", UNARY)
TOKEN_UNOP(EXCLAIM,     "exclaim",     "!",  UNARY)
TOKEN_UNOP(TILDE,       "tilde",       "~",  UNARY)

/*..............................KEYWORD.......................................*/

#ifndef TOKEN_KEYWORD
#define TOKEN_KEYWORD(KIND, NAME) TOKEN(KEYWORD_##KIND, NAME, NAME)
#endif

TOKEN_KEYWORD(IMPORT,   "import")
TOKEN_KEYWORD(PRIVATE,  "private")
TOKEN_KEYWORD(PUBLIC,   "public")
TOKEN_KEYWORD(CLASS,    "class")
TOKEN_KEYWORD(AS,       "as")
TOKEN_KEYWORD(TYPE,     "type")
TOKEN_KEYWORD(FUN,      "fun")
TOKEN_KEYWORD(BEGIN,    "begin")
TOKEN_KEYWORD(END,      "end")
TOKEN_KEYWORD(CONST,    "const")
TOKEN_KEYWORD(VAR,      "var")
TOKEN_KEYWORD(IF,       "if")
TOKEN_KEYWORD(THEN,     "then")
TOKEN_KEYWORD(ELSE,     "else")
TOKEN_KEYWORD(WHILE,    "while")
TOKEN_KEYWORD(DO,       "do")
TOKEN_KEYWORD(LOOP,     "loop")
TOKEN_KEYWORD(UNTIL,    "until")
TOKEN_KEYWORD(BREAK,    "break")
TOKEN_KEYWORD(CONTINUE, "continue")
TOKEN_KEYWORD(RETURN,   "return")
TOKEN_KEYWORD(DEFER,    "defer")

/*..............................LITERAL.......................................*/

#ifndef TOKEN_LITERAL
#define TOKEN_LITERAL(KIND, NAME) TOKEN(LITERAL_##KIND, NAME, NAME)
#endif

TOKEN_LITERAL(STRING, "string")
TOKEN_LITERAL(CHAR,   "char")
TOKEN_LITERAL(DEC,    "dec")
TOKEN_LITERAL(OCT,    "oct")
TOKEN_LITERAL(HEX,    "hex")
TOKEN_LITERAL(BIN,    "bin")
TOKEN_LITERAL(BOOL,   "bool")

/*..............................END OF DEFINES................................*/

#undef TOKEN
#undef TOKEN_MISC
#undef TOKEN_PUNC
#undef TOKEN_OP
#undef TOKEN_BINOP
#undef TOKEN_UNOP
#undef TOKEN_KEYWORD
#undef TOKEN_LITERAL